# =====================================================================
# Atmosphere Console - Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# Google Cloud Platform & BigQuery / Firestore Config
# ---------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json
BIGQUERY_DATASET=atmosphere_data

# ---------------------------------------------------------------------
# AI / LLM Configuration (Gemini)
# ---------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------
# External Data Provider APIs
# ---------------------------------------------------------------------
# OpenAQ API Key (for v3 endpoint access)
OPENAQ_API_KEY=your-openaq-api-key

# NASA FIRMS MAP Key (for satellite fire hotspot ingestion)
FIRMS_MAP_KEY=your-nasa-firms-map-key

# Open-Meteo API (Free tier available; leave blank unless using commercial key)
OPEN_METEO_API_KEY=

# ---------------------------------------------------------------------
# Media Storage (Cloudinary)
# ---------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---------------------------------------------------------------------
# Application Feature Flags
# ---------------------------------------------------------------------
# Set to True to use synthetic/mock data for offline demo mode
USE_MOCK=False